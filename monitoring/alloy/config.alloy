local.file_match "monitored_app_logs" {
  path_targets = [{
    __path__ = "/var/log/monitored-app/app.jsonl",

  }]
}

loki.source.file "monitored_app_logs" {
  targets    = local.file_match.monitored_app_logs.targets
  forward_to = [loki.process.monitored_app_logs.receiver]
}

loki.process "monitored_app_logs" {
  stage.json {
    expressions = {
      level      = "level",
      event      = "event",
      message    = "message",
      request_id = "request_id",
      service    = "service",
    }
  }

  stage.labels {
    values = {
      level   = "level",
      event   = "event",
      service = "service",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
